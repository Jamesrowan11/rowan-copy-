// Rowan Copy — Prisma schema
//
// PRODUCTION uses PostgreSQL (provider below). For quick LOCAL dev with SQLite,
// change `provider` to "sqlite", set DATABASE_URL="file:./dev.db" and run
// `npm run db:push`. The schema intentionally avoids native enums and uses
// String fields (with constants enforced in app code) so the SAME schema works
// on both Postgres and SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CLIENT") // CLIENT | EMPLOYEE | ADMIN
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  projectsAsClient   Project[] @relation("ClientProjects")
  projectsAsAssignee Project[] @relation("AssigneeProjects")

  projectNotes  ProjectNote[]  @relation("ProjectNoteAuthor")
  clientNotesAbout ClientNote[] @relation("ClientNoteSubject")
  clientNotesAuthored ClientNote[] @relation("ClientNoteAuthor")
  employeeNotesAbout EmployeeNote[] @relation("EmployeeNoteSubject")
  employeeNotesAuthored EmployeeNote[] @relation("EmployeeNoteAuthor")

  uploadedDocuments Document[] @relation("DocumentUploader")
  clientDocuments   Document[] @relation("DocumentClient")

  paymentsAsClient Payment[] @relation("PaymentClient")

  sentEmails    EmailLog[]    @relation("EmailSender")
  announcements Announcement[] @relation("AnnouncementAuthor")
  monthlyPlan   MonthlyPlan?

  threadParticipations ThreadParticipant[]
  sentMessages         Message[] @relation("MessageSender")

  brandVoiceProfile BrandVoiceProfile? @relation("BrandVoiceClient")

  quotesAsClient Quote[] @relation("QuoteClient")
  templates      Template[] @relation("TemplateAuthor")
  reviewsAsClient Review[] @relation("ReviewClient")
  auditLogs      AuditLog[] @relation("AuditActor")
  mailboxes      Mailbox[]  @relation("MailboxOwner")
  demosCreated   Demo[]     @relation("DemoCreator")
  mailboxRequests         MailboxRequest[] @relation("MailboxRequester")
  mailboxRequestDecisions MailboxRequest[] @relation("MailboxRequestDecider")
  adCampaigns             AdCampaign[]     @relation("AdCampaignClient")
  adCampaignsCreated      AdCampaign[]     @relation("AdCampaignCreator")

  // "Mailbox management" switch: when an admin enables it for a customer, that
  // customer can manage their own mailbox AND create teammates (each a portal
  // login + mailbox) on their own domain.
  mailAdmin            Boolean @default(false)
  mailDomain           String? // the domain this customer manages mail for
  mailWorkspaceOwnerId String? // set on teammates -> the customer who manages them
  mailWorkspaceOwner   User?   @relation("MailWorkspace", fields: [mailWorkspaceOwnerId], references: [id])
  mailTeam             User[]  @relation("MailWorkspace")
}

// A saved advertising campaign the studio composes for a customer (AI-assisted).
// A workbench for Google/Meta ad assets; live platform push comes later.
model AdCampaign {
  id           String   @id @default(cuid())
  clientId     String?  // optional link to a client User
  client       User?    @relation("AdCampaignClient", fields: [clientId], references: [id], onDelete: SetNull)
  businessName String   // the customer/business the ads are for
  platform     String   // Google | Meta | Both
  objective    String?  // Leads | Sales | Traffic | Awareness | Calls | ...
  audience     String?  // targeting notes
  budget       String?  // freeform, e.g. "$25/day"
  // Draft | Ready | Launched
  status       String   @default("Draft")
  content      String?  // JSON of generated ad assets (headlines, descriptions, etc.)
  createdById  String
  createdBy    User     @relation("AdCampaignCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A client's request for an @rowancopy.com email account. An admin approves
// (which provisions a real Plesk mailbox and assigns it to them) or denies it.
model MailboxRequest {
  id           String    @id @default(cuid())
  requesterId  String
  requester    User      @relation("MailboxRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  desiredLocal String    // requested local part, e.g. "john" in john@rowancopy.com
  domain       String    @default("rowancopy.com")
  note         String?   // optional message from the requester
  // Pending | Approved | Denied
  status       String    @default("Pending")
  decisionNote String?   // admin's note on approval/denial
  mailboxId    String?   // the Mailbox created on approval (no FK; informational)
  decidedById  String?
  decidedBy    User?     @relation("MailboxRequestDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Inquiries / quote requests (public contact form + client requests)
// ---------------------------------------------------------------------------

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  business    String?
  email       String
  phone       String?
  serviceType String   // one of the SERVICE_TYPES, or "Other"
  budget      String?
  message     String
  status      String   @default("New") // New | Reviewed | Converted | Archived
  source      String   @default("public") // public | client-portal | monthly-plan
  clientId    String?  // set when submitted by a logged-in client
  createdAt   DateTime @default(now())

  convertedProjectId String?
}

// ---------------------------------------------------------------------------
// Projects (the core "job" object)
// ---------------------------------------------------------------------------

model Project {
  id                    String    @id @default(cuid())
  title                 String
  type                  String    // SERVICE_TYPES
  scope                 String    // brief / scope description
  status                String    @default("Inquiry")
  quotedPrice           Float?
  revisionRoundsIncluded Int      @default(1)
  revisionRoundsUsed    Int       @default(0)
  dueDate               DateTime?
  cancelledReason       String?
  cancelledAt           DateTime?
  customDomain          String?   // the client's domain being pointed at our server
  customDomainStatus    String    @default("None") // None | Pending | Live

  clientId   String
  client     User    @relation("ClientProjects", fields: [clientId], references: [id])
  assigneeId String?
  assignee   User?   @relation("AssigneeProjects", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes       ProjectNote[]
  documents   Document[]
  payments    Payment[]
  brief       Brief?
  quote       Quote?
  reviews     Review[]
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ProjectNoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Internal notes about people (never visible to the subject / clients)
// ---------------------------------------------------------------------------

model ClientNote {
  id           String   @id @default(cuid())
  clientUserId String
  clientUser   User     @relation("ClientNoteSubject", fields: [clientUserId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  body         String
  createdAt    DateTime @default(now())
}

model EmployeeNote {
  id             String   @id @default(cuid())
  employeeUserId String
  employeeUser   User     @relation("EmployeeNoteSubject", fields: [employeeUserId], references: [id], onDelete: Cascade)
  authorId       String
  author         User     @relation("EmployeeNoteAuthor", fields: [authorId], references: [id])
  body           String
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Documents / deliverables
// ---------------------------------------------------------------------------

model Document {
  id           String   @id @default(cuid())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId     String
  client       User     @relation("DocumentClient", fields: [clientId], references: [id])
  uploaderId   String
  uploader     User     @relation("DocumentUploader", fields: [uploaderId], references: [id])
  kind         String   @default("deliverable") // deliverable | document
  originalName String
  storedName   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Payments (manual Stripe links)
// ---------------------------------------------------------------------------

model Payment {
  id          String    @id @default(cuid())
  clientId    String
  client      User      @relation("PaymentClient", fields: [clientId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  description String
  amount      Float?
  stripeUrl   String
  status      String    @default("Sent") // Sent | Paid
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
}

// ---------------------------------------------------------------------------
// Email log + signature
// ---------------------------------------------------------------------------

model EmailLog {
  id           String   @id @default(cuid())
  senderUserId String?
  sender       User?    @relation("EmailSender", fields: [senderUserId], references: [id])
  to           String   // comma-separated recipients
  subject      String
  body         String
  status       String   @default("sent") // sent | logged | failed
  direction    String   @default("outbound") // outbound | inbound
  createdAt    DateTime @default(now())
}

model Signature {
  id        String   @id @default(cuid())
  text      String
  html      String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Monthly plan ($30/mo hosting + upkeep)
// ---------------------------------------------------------------------------

model MonthlyPlan {
  id          String    @id @default(cuid())
  clientId    String    @unique
  client      User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  active      Boolean   @default(true)
  renewalDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Thread {
  id        String   @id @default(cuid())
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ThreadParticipant[]
  messages     Message[]
}

model ThreadParticipant {
  id         String    @id @default(cuid())
  threadId   String
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@unique([threadId, userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation("MessageSender", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// Inbound emails that couldn't be matched to a user -> admin "Unmatched Inbox"
model InboundEmail {
  id        String   @id @default(cuid())
  fromEmail String
  subject   String
  body      String
  matched   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Smart additions
// ---------------------------------------------------------------------------

model Brief {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audience    String?
  goal        String?
  tone        String?
  avoid       String?  // words/phrases to avoid
  competitors String?
  mustInclude String?
  links       String?
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrandVoiceProfile {
  id           String   @id @default(cuid())
  clientId     String   @unique
  client       User     @relation("BrandVoiceClient", fields: [clientId], references: [id], onDelete: Cascade)
  tone         String?
  bannedCliches String?
  keyTerms     String?
  notes        String?
  updatedAt    DateTime @updatedAt
}

model Quote {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("QuoteClient", fields: [clientId], references: [id])
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  inquiryId String?
  title     String
  notes     String?
  status    String   @default("Draft") // Draft | Sent | Accepted | Declined
  sentAt    DateTime?
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems QuoteLineItem[]
}

model QuoteLineItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label     String
  quantity  Int     @default(1)
  unitPrice Float   @default(0)
}

model Template {
  id        String   @id @default(cuid())
  authorId  String?
  author    User?    @relation("TemplateAuthor", fields: [authorId], references: [id])
  category  String   // caption | email | policy | website | other
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  clientId   String?
  client     User?    @relation("ReviewClient", fields: [clientId], references: [id])
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorName String
  business   String?
  rating     Int?
  body       String?
  status     String   @default("Requested") // Requested | Submitted | Featured
  featured   Boolean  @default(false)
  token      String?  @unique
  createdAt  DateTime @default(now())
  submittedAt DateTime?
}

// A real email mailbox on the mail server (e.g. Plesk), connected to the portal
// for sending (SMTP) and reading (IMAP). A mailbox is either owned by one
// employee/admin or shared (ownerId null, shared = true) like info@rowancopy.com.
model Mailbox {
  id            String   @id @default(cuid())
  address       String   @unique // the email address, e.g. mara@rowancopy.com
  displayName   String   // From display name, e.g. "Mara Ellis — Rowan Copy"
  ownerId       String?  // null = shared mailbox
  owner         User?    @relation("MailboxOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shared        Boolean  @default(false)

  // Connection settings.
  imapHost      String
  imapPort      Int      @default(993)
  imapSecure    Boolean  @default(true)
  smtpHost      String
  smtpPort      Int      @default(587)
  smtpSecure    Boolean  @default(false)
  username      String   // login (usually the full email address)
  passwordEnc   String?  // AES-256-GCM encrypted; null until the owner sets it

  // Per-mailbox signature, appended to messages sent from it.
  signatureText String?
  signatureHtml String?

  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Lead Generator: a prospect business researched + given a sample one-page site
// deployed to a subdomain. Can be converted into a Project + Client like an Inquiry.
model Demo {
  id                 String   @id @default(cuid())
  businessName       String
  city               String
  industry           String
  email              String
  currentWebsite     String?
  subdomainLabel     String?
  liveUrl            String?
  researchSummary    String?
  foundExistingSite  Boolean?
  emailSubject       String?
  emailBody          String?
  // Queued | Building | Ready | DeployFailed | Error | Imported | Editing | EditFailed
  status             String   @default("Queued")
  score              Int?
  tier               String?  // Hot | Warm | Cold
  html               String?  // current generated site HTML (source for AI edits)
  lastEditInstruction String?
  lastEditedAt       DateTime?
  customDomain       String?
  // None | Checking | ReadyToGoLive | Pending | Live | Failed
  customDomainStatus String   @default("None")
  lastDnsCheck       String?  // latest pre-flight readiness report
  outreachSentAt     DateTime? // when the AI board (or a human) sent the outreach email
  createdById        String
  createdBy          User     @relation("DemoCreator", fields: [createdById], references: [id])
  convertedProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// One run of the AI board of directors: what each director did (or would do,
// in dry-run), plus the chairman's executive summary.
model BoardRun {
  id         String   @id @default(cuid())
  mode       String   // dry-run | live
  trigger    String   @default("schedule") // schedule | manual
  actions    Int      @default(0) // total concrete actions taken (or simulated)
  report     String   // JSON: per-director sections + chairman summary
  startedAt  DateTime @default(now())
  finishedAt DateTime?
}

// Simple key-value settings (automation toggles, etc.). Missing keys fall back
// to defaults in app code, so no seeding is required.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String   // create | update | delete | login | etc.
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())
}

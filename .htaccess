# Rowan Copy: Apache / LiteSpeed rules (cPanel)
Options -Indexes
DirectoryIndex index.php

# Never serve private files: config, code libraries, Composer files, dotfiles
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|README\.md)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On
# Block lib/ and vendor/ folders entirely
RewriteRule ^(lib|vendor|lovable-site)(/|$) - [F,L]
RewriteRule \.sh$ - [F,L]
# Pretty URLs for customer sites: /s/my-bakery -> site.php?s=my-bakery
RewriteRule ^s/([a-z0-9-]+)/?$ site.php?s=$1 [L,QSA]
# Search engines and referral links
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^r/([A-Za-z0-9]{4,16})/?$ ref.php?c=$1 [L,QSA]

# Marketing pages. When the Lovable site is installed in site/, its pages are served
# (index.php serves it for "/"); otherwise the built-in PHP pages are used.
RewriteCond %{DOCUMENT_ROOT}/site/index.html -f
RewriteRule ^(services|work|about|pricing|contact)/?$ site/$1/index.html [L]
# The marketing site's scripts and styles
RewriteRule ^static/(.+)$ site/static/$1 [L]
RewriteRule ^(services|work|about|pricing|contact)/?$ $1.php [L]
# Old .php addresses of the marketing pages move to the clean ones once the Lovable site is in.
RewriteCond %{DOCUMENT_ROOT}/site/index.html -f
RewriteCond %{THE_REQUEST} \s/(services|work|about|pricing|contact)\.php[\s?]
RewriteRule ^ /%1 [R=301,L]

# Force HTTPS (uncomment once your SSL certificate is active)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

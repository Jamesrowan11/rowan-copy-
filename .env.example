# ----------------------------------------------------------------------------
# Rowan Copy — environment variables
# Copy this file to ".env" and fill in real values. The app runs end-to-end
# locally with NO email keys set (emails are logged to the console instead).
# ----------------------------------------------------------------------------

# Database connection string.
# PRODUCTION (PostgreSQL on the Plesk/Ubuntu server, or hosted Postgres):
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# LOCAL QUICK DEV with SQLite: set provider = "sqlite" in prisma/schema.prisma
# and use:  file:./dev.db
DATABASE_URL="postgresql://rowan:rowan@127.0.0.1:5432/rowancopy?schema=public"

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the app (used by Auth.js and for links in emails).
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Email layer. Transport is chosen automatically, in priority order:
#   1. SMTP (Plesk mail server) — when SMTP_HOST is set
#   2. Resend — when RESEND_API_KEY is set
#   3. Console log — otherwise (the app still runs; emails go to the server log)
# The address every email is sent from (and where replies go). Use a mailbox you
# control, e.g. info@rowancopy.com created in Plesk → Mail.
EMAIL_FROM="Rowan Copy <info@rowancopy.com>"

# --- Option 1: SMTP via Plesk mail server (recommended for this setup) -------
# Create the mailbox in Plesk → Mail, then use its address + password here.
SMTP_HOST="rowancopy.com"          # your Plesk mail host (often the domain itself)
SMTP_PORT="587"                    # 587 (STARTTLS) or 465 (implicit TLS)
SMTP_USER="info@rowancopy.com"     # full email address of the mailbox
SMTP_PASS=""                       # the mailbox password
# SMTP_SECURE="false"              # optional; auto = true only on port 465

# --- Option 2: Resend (leave SMTP_HOST blank to use this instead) ------------
RESEND_API_KEY=""

# Shared secret for the inbound-email webhook (POST /api/email/inbound).
# If unset, the webhook is OPEN (local dev only). Always set this in production.
INBOUND_WEBHOOK_SECRET=""
